{
  "name": "@local/demographic-coder",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "人口学变量录入台：导入 Excel/Word 问卷、填空录入、按人口学编码导出 CSV",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "dataset.js",
    "study-context.mjs",
    "study-selection.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "minVersion": "0.2.2-rc.1"
  }
}
